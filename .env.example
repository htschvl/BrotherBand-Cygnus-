###############################################################################
# BrotherBand / Cygnus — environment template.
# Copy to `.env` and fill in. Anything required-but-empty fails fast at boot.
###############################################################################

# development | staging | production
APP_ENV=development
LOG_LEVEL=info

# HTTP
HTTP_ADDR=:3000
HTTP_ALLOWED_ORIGINS=http://localhost:3333
HTTP_COOKIE_DOMAIN=

# Postgres — DSN. Supports any pgx/v5 connection string.
DATABASE_URL=postgres://brotherband:brotherband@localhost:5432/brotherband?sslmode=disable

# JWT
# JWT_SECRET MUST be at least 32 characters of entropy in production.
JWT_SECRET=change-me-please-make-this-at-least-32-bytes
JWT_ISSUER=brotherband
JWT_AUDIENCE=brotherband-web
JWT_TTL_HOURS=720

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brotherband-media
R2_CDN_BASE_URL=https://cdn.brotherband.app
